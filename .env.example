# Copia este archivo a .env y ajusta los valores.

# PostgreSQL (docker-compose.yml de desarrollo)
POSTGRES_USER=trackapp
POSTGRES_PASSWORD=trackapp
POSTGRES_DB=trackapp_dev
POSTGRES_PORT=5432

# Cadena de conexión que usará Prisma (Fase 1, paso 3)
DATABASE_URL="postgresql://trackapp:trackapp@localhost:5432/trackapp_dev?schema=public"

# Auth.js — secreto para firmar/cifrar el JWT de sesión.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"

# Confiar en el header Host (necesario con `next start` y detrás de Nginx).
AUTH_TRUST_HOST=true
